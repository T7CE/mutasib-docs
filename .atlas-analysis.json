  "keyFeatures": [
    "Barcode-based Point of Sale (POS) with digital and printed receipts",
    "Real-time cloud inventory tracking with low-stock alerts",
    "M.AI conversational assistant (Arabic & English) for shop queries",
    "AI-powered demand forecasting and reorder suggestions",
    "Staff invitation and multi-cashier management",
    "Customer credit notes and debt tracking",
    "Analytics dashboard: revenue trends, top products, category breakdowns",
    "Offline-first sync for uninterrupted selling",
    "Public product and shop discovery search",
    "OpenFood barcode database integration for product import",
    "Subscription plans: Free, Starter ($7/mo), Pro ($19/mo)"
  ],
  "publicApiSurface": [
    "POST /api/v1/auth/register",
    "POST /api/v1/auth/login",
    "POST /api/v1/auth/login-2fa",
