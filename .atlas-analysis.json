    "GET  /api/v1/shops/{shop_id}/products/barcode/{barcode}/",
    "POST /api/v1/shops/import",
    "POST /api/v1/shops/{shop_id}/sales/",
    "GET  /api/v1/shops/{shop_id}/sales/",
    "GET  /api/v1/shops/{shop_id}/inventory/",
    "PATCH /api/v1/shops/{shop_id}/inventory/{product_id}/",
    "GET  /api/v1/shops/{shop_id}/analytics",
    "POST /api/v1/shops/{shop_id}/ai/mutasib",
    "POST /api/v1/shops/{shop_id}/ai/predict",
    "POST /api/v1/shops/{shop_id}/ai/reorder",
